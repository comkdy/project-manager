# App metadata database: stores users, dashboards, datasets and DB registrations.
# Source/analysis databases are registered and activated in the web DB settings.
# Store real values in ignored .env.
APP_DATABASE_URL=
# Table visibility is managed per database using switches in the same screen.
# Optional Fernet key for saved DB credentials. If blank, the app creates
# .local/db-credentials.key. Back up the key separately from the metadata DB.
DB_CREDENTIALS_KEY=
DEMO_MODE=false

# SSO is the default. Local test administrator requires DEMO_MODE=true and loopback.
AUTH_MODE=sso
SSO_COOKIE_NAME=
SSO_BOOTSTRAP_ADMIN_EMPLOYEE_ID=
# Wire backend/app/sso_adapter.py to the company's verification + directory APIs.
# No SSO URL/protocol is assumed and no local fallback occurs in sso mode.

# Administrator-configured LLM: API base URL or full /chat/completions URL.
LLM_BASE_URL=
LLM_MODEL=
# Each user registers an API key in Profile > LLM API key settings.
# The app creates .local/llm-credentials.key to encrypt personal API keys.
# Back up that file separately from the metadata DB; personal chat keys are not stored in .env.

# Server-only shared key for AI knowledge collection and answer structuring.
# Never expose this value through VITE_* variables, APIs or browser settings.
KNOWLEDGE_LLM_API_KEY=
# AI knowledge always uses the shared LLM_BASE_URL / LLM_MODEL above.
# Enable a schedule in AI Knowledge > Questions; all registered datasets are discovered automatically.

QUERY_TIMEOUT_MS=30000
CACHE_TTL_SECONDS=60
MAX_SCATTER_POINTS=20000
MAX_RENDER_POINTS=10000
